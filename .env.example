# ═══════════════════════════════════════════════════════════════
# GasFlow — Environment Variables
# Copy this file to .env and fill in the values.
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_DB=gasflow
POSTGRES_USER=gasflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432

# ── Backend (FastAPI) ──────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DATABASE_URL=postgresql+psycopg2://gasflow:CHANGE_ME_STRONG_PASSWORD@postgres:5432/gasflow
WHATSAPP_SERVICE_URL=http://whatsapp:3000
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
SESSION_TTL_MINUTES=60
BACKEND_PORT=8000

# Rate limiting: memory (default, single worker) | redis (multi-worker/prod)
RATE_LIMIT_MODE=memory
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ── Frontend (React/Vite) ──────────────────────────────────────
VITE_API_BASE_URL=/api
FRONTEND_PORT=5173

# ── WhatsApp Service ───────────────────────────────────────────
WHATSAPP_PORT=3001
# Chave service-to-service compartilhada (backend → whatsapp via Bearer e
# whatsapp → backend via X-GasFlow-Key). Defina o MESMO valor aqui e no
# whatsapp/.env (MARCOS_GAS_API_KEY) para o bridge de mensagens funcionar.
MARCOS_GAS_API_KEY=
# Backend aceita a chave também como WHATSAPP_SERVICE_KEY (default = MARCOS_GAS_API_KEY)

# Bridge de mensagens recebidas (whatsapp → backend /whatsapp/incoming)
GASFLOW_BACKEND_URL=http://backend:8000
GASFLOW_SERVICE_KEY=${MARCOS_GAS_API_KEY}

# Heartbeat de presença (min) — mantém a sessão ativa
WA_HEARTBEAT_INTERVAL_MIN=5
# Pacing de campanhas (ms) — intervalo aleatório anti-rajada
WA_SEND_MIN_INTERVAL_MS=2000
WA_SEND_MAX_INTERVAL_MS=10000
# Alerta externo quando a reconexão esgota as tentativas (ex.: Slack/n8n)
WA_CRITICAL_WEBHOOK_URL=

# ── IA (LLM) ────────────────────────────────────────────────────
# Provider ativo: mock (default/dev) | ollama | openai
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3

# ── Áudio (STT/TTS) ────────────────────────────────────────────
# STT: mock (default) | whisper (CLI no PATH)
# TTS: mock (default) | piper (binário + modelos ONNX)
STT_PROVIDER=mock
TTS_PROVIDER=mock
WHISPER_MODEL=base
# PIPER_VOICE=pt_BR-faber-medium
# PIPER_EXECUTABLE=/usr/local/bin/piper
# PIPER_MODELS_DIR=/models

# ── Pagamentos / PIX (fase futura — placeholders) ──────────────
# PIX_ENABLED=false
# PAYMENT_CONFIRMATION_TIMEOUT_MINUTES=30
