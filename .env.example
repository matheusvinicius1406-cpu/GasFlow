# ═══════════════════════════════════════════════════════════════
# GasFlow — Environment Variables
# Copy this file to .env and fill in the values.
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_DB=gasflow
POSTGRES_USER=gasflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432

# ── Backend (FastAPI) ──────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DATABASE_URL=postgresql+psycopg2://gasflow:CHANGE_ME_STRONG_PASSWORD@postgres:5432/gasflow
WHATSAPP_SERVICE_URL=http://whatsapp:3000
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
SESSION_TTL_MINUTES=60
BACKEND_PORT=8000

# ── Frontend (React/Vite) ──────────────────────────────────────
VITE_API_BASE_URL=/api
FRONTEND_PORT=5173

# ── WhatsApp Service ───────────────────────────────────────────
WHATSAPP_PORT=3001
MARCOS_GAS_API_KEY=
