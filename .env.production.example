# ═══════════════════════════════════════════════════════════════
# GasFlow — Variáveis de PRODUÇÃO
# Copie para .env.production e preencha. NUNCA commite valores reais.
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_DB=gasflow
POSTGRES_USER=gasflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Sem mapeamento de porta em produção (só rede interna)

# ── Backend (FastAPI) ──────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DATABASE_URL=postgresql+psycopg2://gasflow:CHANGE_ME_STRONG_PASSWORD@postgres:5432/gasflow
WHATSAPP_SERVICE_URL=http://whatsapp:3000
# Origens do navegador que podem chamar a API (separadas por vírgula)
CORS_ORIGINS=http://localhost,https://gasflow.exemplo.com
LOG_LEVEL=INFO
SESSION_TTL_MINUTES=60

# ── Frontend (React/Vite) ──────────────────────────────────────
# URL pública da API vista pelo navegador. Com nginx fazendo proxy,
# basta /api (a origem da página é usada).
VITE_API_BASE_URL=/api

# ── WhatsApp Service ───────────────────────────────────────────
# Chave usada no service-to-service (Authorization: Bearer <key>)
MARCOS_GAS_API_KEY=CHANGE_ME_WHATSAPP_KEY
WHATSAPP_PORT=3001

# ── IA (fases 10-14 — placeholders, ainda não consumidos) ─────
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_SECONDS=60

# ── Pagamentos / PIX (fase futura — placeholders) ──────────────
