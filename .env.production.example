# ═══════════════════════════════════════════════════════════════
# GasFlow — Variáveis de PRODUÇÃO
# Copie para .env.production e preencha. NUNCA commite valores reais.
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_DB=gasflow
POSTGRES_USER=gasflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Sem mapeamento de porta em produção (só rede interna)

# ── Backend (FastAPI) ──────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DATABASE_URL=postgresql+psycopg2://gasflow:CHANGE_ME_STRONG_PASSWORD@postgres:5432/gasflow
WHATSAPP_SERVICE_URL=http://whatsapp:3000
# Origens do navegador que podem chamar a API (separadas por vírgula)
CORS_ORIGINS=http://localhost,https://gasflow.exemplo.com
LOG_LEVEL=INFO
SESSION_TTL_MINUTES=60

# ============================================
# Rate Limiting / Escala
# ============================================
# Backend do rate limiter: memory | redis (recomendado em produção,
# compartilhado entre workers/instâncias)
RATE_LIMIT_MODE=redis
RATE_LIMIT_REDIS_URL=redis://redis:6379/0

# ── Frontend (React/Vite) ──────────────────────────────────────
# URL pública da API vista pelo navegador. Com nginx fazendo proxy,
# basta /api (a origem da página é usada).
VITE_API_BASE_URL=/api

# ── WhatsApp Service ───────────────────────────────────────────
# Chave usada no service-to-service (Authorization: Bearer <key>)
MARCOS_GAS_API_KEY=CHANGE_ME_WHATSAPP_KEY
WHATSAPP_PORT=3001

# ── IA (LLM) ────────────────────────────────────────────────────
# Provider ativo: mock | ollama | openai. Em produção: ollama (ou
# openai com OPENAI_API_KEY). mock nunca deve alimentar produção.
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3

# ── Áudio (STT/TTS) ────────────────────────────────────────────
# STT: mock | whisper (CLI no PATH do container)
# TTS: mock | piper (binário + modelos ONNX em /models)
STT_PROVIDER=mock
TTS_PROVIDER=mock
WHISPER_MODEL=base
PIPER_VOICE=pt_BR-faber-medium
PIPER_EXECUTABLE=/usr/local/bin/piper
PIPER_MODELS_DIR=/models

# ── Pagamentos / PIX (fase futura — placeholders) ──────────────
# PIX_ENABLED=false
# PIX_STATIC_PAYLOAD_PREFIX=00020126
# PAYMENT_CONFIRMATION_TIMEOUT_MINUTES=30