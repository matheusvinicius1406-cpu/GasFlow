{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-native",
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/logic/**/*.ts", "tests/**/*.ts"]
}
