# GasFlow WhatsApp Service — Environment Variables
# Copy to .env and adjust.

# Porta HTTP do serviço (dev local usa 3001; em Docker o compose usa 3000)
PORT=3001

# Diretório dos dados (SQLite de contatos/listas/campanhas)
DATA_DIR=./data

# ── Autenticação (backend → whatsapp e whatsapp → backend) ──────────────
# Chave compartilhada service-to-service. Deve ser a MESMA no backend
# (MARCOS_GAS_API_KEY / WHATSAPP_SERVICE_KEY lá) e aqui.
# Vazia = autenticação desabilitada (apenas dev local).
# ⚠️ Obrigatória com ENVIRONMENT=production — sem ela o serviço NÃO SOBE.
MARCOS_GAS_API_KEY=
# ENVIRONMENT=production

# ── Mídia por caminho (allowlist de segurança) ─────────────────────────
# POST /api/whatsapp/accounts/:id/media aceita mediaPath SOMENTE dentro
# deste diretório (resolvido canonicamente; caminhos relativos/`../` fora → 400).
# WA_UPLOADS_DIR=./uploads

# ── Bridge de mensagens recebidas (whatsapp → backend GasFlow) ──────────
# URL base do backend FastAPI. Vazia = bridge desligado.
# Dev local: http://localhost:8000 | Docker: http://backend:8000
GASFLOW_BACKEND_URL=http://localhost:8000
# Chave enviada como header X-GasFlow-Key ao backend (mesmo valor de MARCOS_GAS_API_KEY)
GASFLOW_SERVICE_KEY=

# ── CRM sync (push de contatos → backend) ───────────────────────────────
# Tamanho do lote do POST /clients/contacts/sync-batch (default 100)
BATCH_SYNC_SIZE=100

# ── Heartbeat (mantém a sessão ativa) ──────────────────────────────────
# Intervalo em minutos do sendPresenceAvailable() após connect (default 5)
WA_HEARTBEAT_INTERVAL_MIN=5

# ── Pacing de campanhas (comportamento humano, anti-rajada) ─────────────
# Intervalo aleatório entre envios do broadcast worker (default 2000–10000 ms)
WA_SEND_MIN_INTERVAL_MS=2000
WA_SEND_MAX_INTERVAL_MS=10000

# ── Alerta de falha crítica ─────────────────────────────────────────────
# URL (ex.: webhook do Slack/n8n) chamada quando a reconexão esgota as
# tentativas. Vazia = sem alerta externo (apenas log estruturado).
WA_CRITICAL_WEBHOOK_URL=

# ── Log estruturado (JSON lines) ────────────────────────────────────────
# debug | info | warn | error
WA_LOG_LEVEL=info

# ── Navegador (opcional) ────────────────────────────────────────────────
# Caminho do executável do navegador (auto-detectado se vazio)
# WHATSAPP_EXECUTABLE_PATH=/usr/bin/chromium

# Modo headful (mostra a janela do WhatsApp Web — debug)
WHATSAPP_HEADFUL=false
