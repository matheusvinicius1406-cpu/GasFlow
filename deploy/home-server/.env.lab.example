# ═══════════════════════════════════════════════════════════════
# GasFlow — Laboratório Home Server (OPS-01B) — VALORES FICTÍCIOS
#
# Copie para `deploy/home-server/.env.lab` (ignorado pelo git) e use
# SOMENTE com `docker-compose.homeserver.lab.yml`. Nada aqui é
# reaproveitável em produção: as senhas são placeholders `CHANGE_ME_lab_*`,
# o banco é `gasflow_lab` e o projeto Compose é `gasflow-hs-lab`.
#
#   cp deploy/home-server/.env.lab.example deploy/home-server/.env.lab
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL (banco do laboratório, isolado do produção) ──────
POSTGRES_DB=gasflow_lab
POSTGRES_USER=gasflow_lab
POSTGRES_PASSWORD=CHANGE_ME_lab_postgres_password

# ── Backend (FastAPI) ──────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
ADMIN_PASSWORD=CHANGE_ME_lab_admin_password
DATABASE_URL=postgresql+psycopg2://gasflow_lab:CHANGE_ME_lab_postgres_password@postgres:5432/gasflow_lab
WHATSAPP_SERVICE_URL=http://whatsapp:3000
# Origem real do laboratório: 127.0.0.1:8088 (loopback, ver overlay .lab)
CORS_ORIGINS=http://127.0.0.1:8088,http://localhost:8088
LOG_LEVEL=INFO
SESSION_TTL_MINUTES=60
# i3-10110U (2C/4T) + GasFlow Desktop na mesma máquina → 1 worker.
BACKEND_WORKERS=1
RATE_LIMIT_MODE=redis
RATE_LIMIT_REDIS_URL=redis://redis:6379/0

# ── Frontend (React/Vite) ───────────────────────────────
# A porta é fixada em 127.0.0.1:8088 no overlay do laboratório.
VITE_API_BASE_URL=/api

# ── WhatsApp Gateway ───────────────────────────────────────────
MARCOS_GAS_API_KEY=CHANGE_ME_lab_service_key
ALLOW_INSECURE_AUTH=false
GASFLOW_BACKEND_URL=http://backend:8000
GASFLOW_SERVICE_KEY=CHANGE_ME_lab_service_key
WA_ENGINE=baileys
WA_LOG_LEVEL=info
WA_HEARTBEAT_INTERVAL_MIN=5
WA_SEND_MIN_INTERVAL_MS=2000
WA_SEND_MAX_INTERVAL_MS=10000
# Broadcast desligado também no overlay (.lab) — dupla proteção no lab.
WA_BROADCAST_ENABLED=false
WA_CRITICAL_WEBHOOK_URL=

# ── Observabilidade (opcional: --profile observability) ────────
METRICS_PUBLIC=false
ALERTS_WEBHOOK_SECRET=CHANGE_ME_lab_alerts_secret
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_lab_grafana_password

# ── IA ─────────────────────────────────────────────────────────
# Sem Ollama no laboratório: o perfil Home Server não depende de IA local.
AI_PROVIDER=mock

# ── Laboratório ────────────────────────────────────────────────
# Nada compartilhado com a stack real: use `-p gasflow-hs-lab`, containers
# `-lab`, volumes `gasflow-hs-lab_*`, porta fixa em loopback.
