APP_NAME=GasFlow
APP_VERSION=0.1.0
DEBUG=True

# Banco de dados. Para produção use PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://gasflow:gasflow@localhost:5432/gasflow
DATABASE_URL=sqlite:///./gasflow.db

# CORS: origens permitidas, separadas por vírgula.
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8080

# Auth (Fase 2). Gere uma chave forte para produção:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Infra opcional.
# REDIS_URL=redis://localhost:6379/0
