APP_NAME=GasFlow
APP_VERSION=0.1.0
DEBUG=True

DATABASE_URL=sqlite:///./gasflow.db

# ── Segurança / exposição ──────────────────────────────────
# ENVIRONMENT=production desliga /docs, /redoc e /openapi.json
# (o mapa público da API). DOCS_ENABLED=1/0 força em qualquer ambiente.
#ENVIRONMENT=production
#DOCS_ENABLED=1

# RATE_LIMIT_TRUST_PROXY=1 só atrás de proxy reverso que SOBRESCREVE
# X-Forwarded-For. Default: fora — sem proxy, o cliente escolheria o
# próprio IP no rate limit.
#RATE_LIMIT_TRUST_PROXY=1
